# Copy this file to .env and fill in the values. .env is git-ignored: never commit it.

# Claude API key (required). Get it from the course / Anthropic Console.
ANTHROPIC_API_KEY=
# Model used to draft the map.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional but recommended: read-only GitHub token (private repos, higher rate limits).
GITHUB_TOKEN=
# Where the SQLite database is stored.
ONBOARDING_DB_PATH=data/onboarding.db
