      },
      {
        "id": "PR#12",
        "type": "pr",
        "title": "Switch database from MySQL to PostgreSQL",
        "url": "https://github.com/example/library-system/pull/12",
        "text": "We need JSONB columns for flexible book metadata (migrations/002_jsonb_metadata.sql), so app/db.py now uses PostgreSQL. README not updated yet."
      },
      {
        "id": "commit:7b7b7b7",
        "type": "commit",
        "title": "Add loans API",
        "url": "https://github.com/example/library-system/commit/7b7b7b7",
        "text": "Add loans API"
      }
    ],
    "truncation": {}
  },
  "expect": {
    "min_modules": 2,
    "max_modules": 10,
    "must_cite": [
      "PR#12"
